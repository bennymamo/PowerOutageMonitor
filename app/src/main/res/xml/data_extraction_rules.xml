<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_secrets.xml" />
        <exclude domain="sharedpref" path="telegram_config.xml" />
        <exclude domain="sharedpref" path="resend_email_config.xml" />
        <exclude domain="sharedpref" path="gmail_email_config.xml" />
        <exclude domain="sharedpref" path="sms_config.xml" />
        <exclude domain="sharedpref" path="ecoflow_cloud_config.xml" />
        <exclude domain="file" path="alert_delivery_queue.json" />
        <exclude domain="device_file" path="pending_alert_events.json" />
        <exclude domain="device_sharedpref" path="enabled_alert_providers.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_secrets.xml" />
        <exclude domain="sharedpref" path="telegram_config.xml" />
        <exclude domain="sharedpref" path="resend_email_config.xml" />
        <exclude domain="sharedpref" path="gmail_email_config.xml" />
        <exclude domain="sharedpref" path="sms_config.xml" />
        <exclude domain="sharedpref" path="ecoflow_cloud_config.xml" />
        <exclude domain="file" path="alert_delivery_queue.json" />
        <exclude domain="device_file" path="pending_alert_events.json" />
        <exclude domain="device_sharedpref" path="enabled_alert_providers.xml" />
    </device-transfer>
</data-extraction-rules>
